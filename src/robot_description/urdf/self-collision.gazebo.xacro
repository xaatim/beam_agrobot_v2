<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_description">

  <gazebo reference="base_yaw_link">
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="shoulder_link">
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="elbow_link">
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="wrist_pitch_link">
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="wrist_roll_link">
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="camera_link">
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="camera_depth_optical_frame">
    <self_collide>true</self_collide>
  </gazebo>

</robot>